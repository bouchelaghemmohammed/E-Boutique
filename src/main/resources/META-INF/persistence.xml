<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence
                                 https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd"
             version="3.0">

    <persistence-unit name="eboutiquePU" transaction-type="RESOURCE_LOCAL">
        <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>
        <class>com.eboutique.modele.User</class>
        <class>com.eboutique.modele.Product</class>
        <class>com.eboutique.modele.Order</class>
        <class>com.eboutique.modele.OrderItem</class>
        <class>com.eboutique.modele.Role</class>
        <class>com.eboutique.modele.Category</class>
        <class>com.eboutique.modele.Coupon</class>
        
        <exclude-unlisted-classes>false</exclude-unlisted-classes>

        <properties>
            <!-- Connexion MySQL — propriétés injectées via -Ddb.url / -Ddb.user / -Ddb.password -->
            <!-- IMPORTANT : ne pas mettre de valeur par défaut contenant ':' (bug parseur WildFly) -->
            <!-- En local : pom.xml/javaOpts les fournit automatiquement via mvn wildfly:run      -->
            <!-- En Docker : CMD du Dockerfile les injecte via JAVA_OPTS                          -->
            <property name="jakarta.persistence.jdbc.driver"   value="com.mysql.cj.jdbc.Driver"/>
            <property name="jakarta.persistence.jdbc.url"      value="${db.url}"/>
            <property name="jakarta.persistence.jdbc.user"     value="${db.user}"/>
            <property name="jakarta.persistence.jdbc.password" value="${db.password}"/>

            <!-- Configuration Hibernate -->
            <property name="hibernate.dialect"                  value="org.hibernate.dialect.MySQLDialect"/>
            <property name="hibernate.hbm2ddl.auto"             value="update"/>
            <property name="hibernate.show_sql"                 value="true"/>
            <property name="hibernate.format_sql"               value="true"/>

            <!-- Empêcher WildFly de basculer sur la base H2 par défaut -->
            <property name="wildfly.jpa.twophase" value="false" />
        </properties>
    </persistence-unit>

</persistence>
