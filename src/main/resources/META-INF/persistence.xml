<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence
                                 https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd"
             version="3.0">

    <persistence-unit name="eboutiquePU" transaction-type="RESOURCE_LOCAL">
        <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>
        <class>com.eboutique.modele.User</class>
        <class>com.eboutique.modele.Product</class>
        <class>com.eboutique.modele.Order</class>
        <class>com.eboutique.modele.OrderItem</class>
        <class>com.eboutique.modele.Role</class>
        <class>com.eboutique.modele.Category</class>
        <class>com.eboutique.modele.Coupon</class>
        
        <exclude-unlisted-classes>false</exclude-unlisted-classes>

        <properties>
           
            <property name="jakarta.persistence.jdbc.driver"   value="com.mysql.cj.jdbc.Driver"/>
            <!-- WildFly supporte ${prop:default} dans persistence.xml :
                 en prod (Railway) db.url est injecte via JAVA_TOOL_OPTIONS,
                 en local la valeur par defaut (localhost) est utilisee. -->
            <property name="jakarta.persistence.jdbc.url"      value="${db.url:jdbc:mysql://localhost:3306/eboutique?useSSL=false&amp;serverTimezone=UTC&amp;allowPublicKeyRetrieval=true}"/>
            <property name="jakarta.persistence.jdbc.user"     value="${db.user:root}"/>
            <property name="jakarta.persistence.jdbc.password" value="${db.password:root}"/>

            <!-- Configuration Hibernate -->
            <property name="hibernate.dialect"                  value="org.hibernate.dialect.MySQLDialect"/>
            <property name="hibernate.hbm2ddl.auto"             value="update"/>
            <property name="hibernate.show_sql"                 value="true"/>
            <property name="hibernate.format_sql"               value="true"/>

            <!-- Empêcher WildFly de basculer sur la base H2 par défaut -->
            <property name="wildfly.jpa.twophase" value="false" />
        </properties>
    </persistence-unit>

</persistence>
