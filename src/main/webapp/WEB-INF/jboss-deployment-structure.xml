<?xml version="1.0" encoding="UTF-8"?>
<!--
    Configuration WildFly :
    - Hibernate : exclu pour utiliser la version du WAR (evite conflits ORM)
    - Jakarta Mail : NON exclu => WildFly fournit angus-mail via son propre
      classloader. Bundler angus-mail dans le WAR causait une erreur
      ServiceLoader (StreamProvider introuvable) car deux classloaders
      voyaient la meme interface.
-->
<jboss-deployment-structure xmlns="urn:jboss:deployment-structure:1.3">
    <deployment>
        <exclusions>
            <module name="org.hibernate"/>
            <module name="org.hibernate.envers"/>
        </exclusions>
    </deployment>
</jboss-deployment-structure>
